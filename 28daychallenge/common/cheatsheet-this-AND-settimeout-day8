// Quick `this` cheat sheet for non-class JavaScript

// 1) Plain function call - Btw "difference between function,method and function expression" below.
function plainFunction() {
  console.log("plainFunction this:", this);
}
plainFunction(); // browser: window (or undefined in strict mode/module)

// 2) Object method (shorthand)- New Style compared to 3 .Cleanest syntax for object methods.Same this behavior as function () {} (3 waala) when called as obj.method().
const obj1 = {
  method() {
    console.log("obj1.method this:", this);
  },
};
obj1.method(); // this = obj1

// 3) Object method (function expression) - Older style of 2
const obj2 = {
  method: function () {
    console.log("obj2.method this:", this);
  },
};
obj2.method(); // this = obj2

// 4) Nested regular function
function outer1() {
  console.log("outer1 this:", this);

  function inner() {
    console.log("inner this:", this);
  }

  inner(); // plain call => browser: window
}
outer1();

// 5) Nested arrow function -when you want to capture outer this(best for callbacks and nested helpers). Not good as object methods if you need this to be the object.
function outer2() {
  console.log("outer2 this:", this);

  const inner = () => {
    console.log("inner arrow this:", this);
  };

  inner(); // inherits outer2's this
}
outer2();

// 6) Callback to array methods
const arr = [1, 2, 3];
arr.map(function (n) {
  console.log("callback this:", this);
  return n * 2;
}); // usually window/undefined depending on strict mode

// 7) Callback with thisArg-Some array methods accept a second argument to set this inside the callback.
arr.map(function (n) {
  console.log("callback with thisArg this:", this);
  return n * 2;
}, { label: "ctx" });

// 8) Bound function
function showThis() {
  console.log("bound this:", this);
}
const bound = showThis.bind({ name: "boundObj" });
bound();//Prints 
/*this: {
name: 'boundObj'
}*/


// Object method declaration variations (non-class)
// Each object also includes a simple property for quick reference.

// 1) Method shorthand
const x1 = {
  name: "x1",
  testInsideObject() {
    console.log("shorthand method", this);
    console.log("name:", this.name);
  },
};
x1.testInsideObject();

// 2) Function expression
const x2 = {
  name: "x2",
  testInsideObject: function () {
    console.log("function expression", this);
    console.log("name:", this.name);
  },
};
x2.testInsideObject();

// 3) Arrow function (NOT recommended for methods if you need `this`)
const x3 = {
  name: "x3",
  testInsideObject: () => {
    console.log("arrow function method", this);
    console.log("name:", this?.name);
  },
};
x3.testInsideObject();

// 4) Named function expression
const x4 = {
  name: "x4",
  testInsideObject: function testInsideObject() {
    console.log("named function expression", this);
    console.log("name:", this.name);
  },
};
x4.testInsideObject();

// 5) Add method after object creation
const x5 = {
  name: "x5",
};
x5.testInsideObject = function () {
  console.log("added later", this);
  console.log("name:", this.name);
};
x5.testInsideObject();

// 6) Define via Object.assign
const x6 = Object.assign(
  {
    name: "x6",
  },
  {
    testInsideObject() {
      console.log("Object.assign + shorthand", this);
      console.log("name:", this.name);
    },
  }
);
x6.testInsideObject();

// 7) Define via Object.defineProperty
const x7 = {
  name: "x7",
};
Object.defineProperty(x7, "testInsideObject", {
  value: function () {
    console.log("defineProperty", this);
    console.log("name:", this.name);
  },
});
x7.testInsideObject();

// 8) Computed method name
const methodName = "testInsideObject";
const x8 = {
  name: "x8",
  [methodName]() {
    console.log("computed method name", this);
    console.log("name:", this.name);
  },
};
x8.testInsideObject();

